# Copy to .env.local and fill in. .env.local is git-ignored and never committed.
#
# Local development (recommended): run `npm run db:start`, then `npx supabase
# status -o env` to print the local stack's URL/keys and paste them below.
# Local dev is rejected if this URL is a hosted *.supabase.co host — that guard
# only fires when NODE_ENV=development, so it never affects production builds.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Canonical browser/public key name. The local CLI prints this as ANON_KEY;
# a hosted project's "Publishable key" also works here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-or-hosted-anon-key
# Legacy/alternate name also accepted (checked first if both are set):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical server-only elevated key name. NEVER exposed to the browser.
# The local CLI prints this as SERVICE_ROLE_KEY; a hosted project's "Secret
# key" also works here.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-or-hosted-service-role-key
# Legacy/alternate name also accepted (checked first if both are set):
# SUPABASE_SECRET_KEY=

# Shared secret required by GET /api/healthcheck.
HEALTHCHECK_SECRET=replace-with-a-random-string

# Vercel Cron secret for GET /api/cron/healthcheck (only needed when deployed).
CRON_SECRET=replace-with-a-random-string

# Optional; base URL used for QR join links. Defaults to the browser origin.
# NEXT_PUBLIC_BASE_URL=http://127.0.0.1:3000
